---
layout: base.njk
permalink: /news/
eleventyExcludeFromCollections: true
eleventyComputed:
    title: "News — World of Warcraft Private Servers"
    canonical: "https://wowprivateservers.vercel.app/news/"
    hero: "News"
    subtitle: "Private server news &amp; updates"
    description: "News and updates on the World of Warcraft private server scene."
---
<ul class="news-list">
{% for n in collections.news | reverse %}
    <li><time>{{ n.date | formatDate }}</time><span class="news-chip" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg></span><a href="{{ n.url }}">{{ n.data.title }}</a>{% if n.data.link %} <a class="news-original" href="{{ n.data.link }}" target="_blank" rel="noopener">original ↗</a>{% endif %}</li>
{% endfor %}
</ul>
