---
layout: base.njk
pagination:
    data: eras
    size: 1
    alias: eraGroup
eleventyExcludeFromCollections: true
eleventyComputed:
    permalink: "/{{ eraGroup.era | lower | slugify }}/"
    title: "{{ eraGroup.era }} Servers — World of Warcraft Private Servers"
    description: "Curated list of {{ eraGroup.era }} World of Warcraft private servers with current status."
    canonical: "https://wowprivateservers.vercel.app/{{ eraGroup.era | lower | slugify }}/"
    hero: "{{ eraGroup.era }} Servers"
    subtitle: "World of Warcraft Private Server Status"
---
<p><a href="/">← All servers</a></p>

{% from "card.njk" import card %}

<div class="cards">
{% for s in eraGroup.servers %}
{{ card(s) }}
{% endfor %}
</div>

<p class="meta-info">List reviewed {{ site.reviewed }}. Statuses subject to change.</p>