---
layout: base.njk
pagination:
    data: eras
    size: 1
    alias: eraGroup
eleventyExcludeFromCollections: true
eleventyComputed:
    permalink: "/{{ eraGroup.era | lower | slugify }}/"
    title: "{{ eraGroup.era }} Servers — World of Warcraft Private Servers"
    description: "Curated list of {{ eraGroup.era }} World of Warcraft private servers with current status."
    canonical: "https://wowprivateservers.vercel.app/{{ eraGroup.era | lower | slugify }}/"
    hero: "{{ eraGroup.era }} Servers"
    subtitle: "World of Warcraft Private Server Status"
---
<p><a href="/">← All servers</a></p>

{% from "card.njk" import card with context %}
{% from "medallion.njk" import eraMedallion %}
{% from "scene.njk" import eraScene with context %}

<div class="era-header">
    {{ eraScene(eraGroup.era) }}
    <div class="era-header-inner">
        {{ eraMedallion(eraGroup.era) }}
        <div>
            <h2>{{ eraGroup.era }}</h2>
            <p>{{ eraGroup.servers.length }} tracked server{{ "s" if eraGroup.servers.length != 1 }} · status reviewed {{ site.reviewed }}</p>
        </div>
    </div>
</div>

{% if expansionIntros[eraGroup.era] %}
<section class="expansion-intro" style="max-width: 75ch; line-height: 1.6; margin: 1.5rem 0;">
{{ expansionIntros[eraGroup.era] | safe }}
<p class="meta-info">Guide category: guides · updated 2026-09-02 · <a href="/">tracker</a> · <a href="/servers/">servers</a></p>
</section>
{% endif %}

<div class="cards">
{% for s in eraGroup.servers %}
{{ card(s) }}
{% endfor %}
</div>

<p class="meta-info">List reviewed {{ site.reviewed }}. Statuses subject to change.</p>