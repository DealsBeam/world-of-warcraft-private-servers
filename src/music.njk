<script>
(function(){
  var sel=document.getElementById('pl'), q=document.getElementById('q'), meta=document.getElementById('pl-meta'), yt=document.getElementById('yt');
  function upd(){
    var opt=sel.options[sel.selectedIndex], id=opt.value, txt=opt.textContent;
    yt.src='https://www.youtube.com/embed/videoseries?list='+id;
    yt.title='Azeroth Ambience — '+txt;
    var m=txt.match(/—\s*(\d+)/); if(meta) meta.textContent=(m?m[1]:'')+' videos — '+txt.split('—')[0].trim();
    try{localStorage.setItem('music_pl',id);}catch(e){}
  }
  sel.addEventListener('change', upd);
  if(q){ q.addEventListener('input', function(){
    var v=q.value.toLowerCase(); for(var i=0;i<sel.options.length;i++){ var t=sel.options[i].textContent.toLowerCase(); sel.options[i].hidden=v && t.indexOf(v)===-1; } if(sel.options[sel.selectedIndex].hidden){ for(var i=0;i<sel.options.length;i++) if(!sel.options[i].hidden){ sel.selectedIndex=i; upd(); break; } }
  });}
  try{var saved=localStorage.getItem('music_pl'); if(saved){ for(var i=0;i<sel.options.length;i++) if(sel.options[i].value===saved){ sel.selectedIndex=i; break; } upd(); }}catch(e){}
})();
</script>
