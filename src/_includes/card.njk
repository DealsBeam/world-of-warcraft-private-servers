{% macro card(s) %}
{% set st = vocab.STATUS[s.status] or { label: "Unknown", cls: "" } %}
{% set era = vocab.ERA[s.tag] or "Other" %}
{% set ic = icons.iconFor(s.name, s.tag) %}
<article class="card card-st-{{ s.status }}{% if s.status === 'dead' %} card-dead{% endif %}">
    <div class="card-head">
        <span class="card-head-left">
            <span class="card-emblem emblem-{{ era | lower | slugify }}" aria-hidden="true"><svg viewBox="{{ icons.viewFor(ic) }}"><path d="{{ icons.pathFor(ic) }}"/></svg></span>
            <span class="server-name"><a class="server-link" href="/servers/{{ s.name | slugify }}/">{{ s.name }}</a>{% if s.group and s.name.indexOf(s.group) === -1 %} <span class="tag tag-group">{{ s.group }}</span>{% endif %}</span>
        </span>
        <span class="badge {{ st.cls }}">{{ st.label }}</span>
    </div>
    <div class="card-details">{{ s.details }}{% if s.tag %} <span class="tag">{{ s.tag }}</span>{% endif %}{% if s.popTier and s.popTier != "unknown" %} <span class="tag tag-pop">{{ s.popTier | capitalize }}</span>{% endif %}{% if s.release %} <span class="tag">Release: {{ s.release }}</span>{% endif %}{% if s.shutdown %} <span class="tag tag-dead">Down {{ s.shutdown }}{% if s.shutdownReason %} · {{ s.shutdownReason }}{% endif %}</span>{% endif %}</div>
    {% if s.url %}<a class="card-site" href="{{ s.url }}" target="_blank" rel="noopener">Official site ↗</a>{% endif %}
</article>
{% endmacro %}