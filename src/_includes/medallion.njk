{% macro medallion(cls, glyph) %}
<svg class="medallion {{ cls }}" viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="16" r="15" class="med-ring"/>
    <g class="med-glyph" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="{{ glyph }}"/>
    </g>
</svg>
{% endmacro %}

{% macro eraMedallion(era) %}
{{ medallion("med-" ~ (era | lower | slugify), ERA_GLYPHS[era] or ERA_GLYPHS["Other"]) }}
{% endmacro %}

{% macro blogMedallion(category) %}
{{ medallion("med-blog med-blog-" ~ (category | slugify), BLOG_GLYPHS[category] or BLOG_GLYPHS["explainers"]) }}
{% endmacro %}