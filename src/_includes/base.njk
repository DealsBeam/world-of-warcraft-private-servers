<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }}{% else %}World of Warcraft Private Server Status List{% endif %}</title>
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="{{ canonical }}">
    <link rel="alternate" type="application/rss+xml" title="World of Warcraft Private Server News" href="https://wowprivateservers.vercel.app/feed.xml">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ canonical }}">
    <script>
        (function () {
            try {
                var t = localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
                document.documentElement.setAttribute("data-theme", t);
            } catch (e) {}
        })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;600;700&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="header-banner">
        <h1>{{ hero }}</h1>
        <p class="subtitle">{{ subtitle }}</p>
        <div class="meta-info">Comprehensive Status Tracker, Emulation History &amp; Development Directory</div>
        <nav class="site-nav">
            <a href="/">Home</a>
            <a href="/news/">News</a>
            <a href="/classic-plus/">Classic+ Tracker</a>
            <a href="/guides/octowow/">OctoWoW Guide</a>
        </nav>
    </header>

    <main id="main-content">
        {{ content | safe }}
    </main>

    <div class="footer">
        List curated and formatted from Discord community updates. Statuses subject to change.
    </div>

</body>
</html>
