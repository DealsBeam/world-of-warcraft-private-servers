<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }}{% else %}World of Warcraft Private Server Status List{% endif %}</title>
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="{{ canonical }}">
    <link rel="alternate" type="application/rss+xml" title="World of Warcraft Private Server News" href="https://wowprivateservers.vercel.app/feed.xml">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:image" content="https://wowprivateservers.vercel.app/og.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="https://wowprivateservers.vercel.app/og.png">
    <script>
        (function () {
            try {
                var t = localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
                document.documentElement.setAttribute("data-theme", t);
            } catch (e) {}
        })();
    </script>
    <link rel="preload" href="/fonts/cinzel.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="header-banner{% if heroImage %} has-photo{% endif %}">
        {% if heroImage %}<img class="hero-photo" src="{{ heroImage }}" alt="" loading="eager" width="1920" height="400">{% endif %}
        <svg class="hero-art" viewBox="0 0 1040 240" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
            <path class="ha-mount-back" d="M0 210 L180 70 L330 200 L480 90 L640 210 L820 110 L1040 220 L1040 240 L0 240 Z"/>
            <path class="ha-mount" d="M0 240 L220 120 L380 230 L560 130 L760 240 L900 170 L1040 235 L1040 240 L0 240 Z"/>
            <path class="ha-keep" d="M470 240 L470 170 L500 170 L500 150 L540 150 L540 170 L570 170 L570 240 Z M505 150 L505 120 L510 118 L510 150 Z M530 150 L530 118 L535 120 L535 150 Z"/>
            <circle class="ha-glow" cx="870" cy="70" r="46"/>
            <circle class="ha-glow" cx="870" cy="70" r="70"/>
        </svg>
        <h1>{{ hero }}</h1>
        <p class="subtitle">{{ subtitle }}</p>
        <div class="meta-info">{{ metaInfo or "Comprehensive Status Tracker, Emulation History &amp; Development Directory" }}</div>
        <div class="theme-toggle" role="group" aria-label="Theme">
            <button type="button" data-theme-choice="light" aria-pressed="false" title="Light theme">☀</button>
            <button type="button" data-theme-choice="system" aria-pressed="false" title="System theme">⚙</button>
            <button type="button" data-theme-choice="dark" aria-pressed="false" title="Dark theme">☾</button>
        </div>
        <nav class="site-nav">
            <a href="/">Home</a>
            <a href="/news/">News</a>
            <a href="/classic-plus/">Classic+ Tracker</a>
            <a href="/guides/octowow/">OctoWoW Guide</a>
            <a href="/blog/">Blog</a>
            <a href="/radio/">Radio</a>
        </nav>
    </header>

    <main id="main-content">
        {{ content | safe }}
    </main>

    <div class="footer">
        Listed servers are unlicensed third-party projects. We are not affiliated with Blizzard Entertainment, and linking does not imply endorsement. List curated and formatted from Discord community updates. Statuses subject to change · last reviewed {{ site.reviewed }}. Icons by <a href="/attribution/">game-icons.net (CC BY 3.0)</a>.
        <br><a href="/disclaimer/">Disclaimer</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a>
    </div>

    <script src="/theme.js"></script>
    <script>
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
    {% for s in extraScripts %}<script src="{{ s }}"></script>{% endfor %}

</body>
</html>
