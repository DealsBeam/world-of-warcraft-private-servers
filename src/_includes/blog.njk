---
layout: base.njk
---
<p><a href="/blog/">← All posts</a></p>
{% from "medallion.njk" import blogMedallion %}
{% if heroImage %}<img class="post-hero" src="{{ heroImage }}" alt="" loading="eager" width="800" height="440">{% endif %}
<div class="blog-post-header">
    {{ blogMedallion(category) }}
    {% if category %}<span class="blog-cat">{{ category }}</span>{% endif %}
</div>
<article class="panel news-post">
    <p class="meta-info">By {{ author }} · <time datetime="{{ isoDate }}">{{ subtitle }}</time></p>
    {{ content | safe }}
</article>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ description | dump | safe }},
    "datePublished": {{ isoDate | dump | safe }},
    "author": {"@type": "Organization", "name": {{ author | dump | safe }}},
    "publisher": {"@type": "Organization", "name": "WoW Private Servers Tracker"},
    "mainEntityOfPage": {{ canonical | dump | safe }},
    "image": "https://wowprivateservers.vercel.app{{ image or (title | ogCard) }}"
}
</script>
