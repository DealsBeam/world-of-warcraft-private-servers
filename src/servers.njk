---
layout: base.njk
pagination:
    data: servers
    size: 1
    alias: server
permalink: "/servers/{{ server.name | slugify }}/"
eleventyExcludeFromCollections: true
eleventyComputed:
    title: "{{ server.name }} — World of Warcraft Private Server"
    description: "{{ server.details }}"
    canonical: "https://wowprivateservers.vercel.app/servers/{{ server.name | slugify }}/"
    hero: "{{ server.name }}"
    subtitle: "World of Warcraft Private Server Status"
---
{% set related = history | relatedHistory(server, server.name | slugify) %}
{% set st = vocab.STATUS[server.status] or { label: "Unknown", cls: "" } %}
{% set badge = st.cls %}{% set statusLabel = st.label %}

<p><a href="/">← All servers</a></p>

<div class="server-hero" style="position: relative; height: 120px; margin-bottom: 20px; border-top: 1px solid var(--border-2); border-bottom: 1px solid var(--border); background: radial-gradient(ellipse 60% 90% at 50% 0%, rgba(196, 154, 40, 0.13), transparent 70%), linear-gradient(180deg, rgba(196, 154, 40, 0.05), transparent 55%);">
    <svg class="hero-art" viewBox="0 0 800 200" preserveAspectRatio="xMidYMid slice" style="width: 100%; height: 100%; pointer-events: none;">
        <defs>
            <linearGradient id="mountGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="rgba(196,154,40,0.10)" />
                <stop offset="100%" stop-color="rgba(196,154,40,0.02)" />
            </linearGradient>
        </defs>
        <path class="ha-mount" d="M0,200 Q200,20 400,80 T800,200 V200 H0 Z" fill="url(#mountGrad)" />
    </svg>
</div>

<article class="card server-detail card-st-{{ server.status }}{% if server.status === 'dead' %} card-dead{% endif %}">
    <div class="card-head">
        <span class="server-name">{{ server.name }}</span>
        <span class="badge {{ badge }}">{{ statusLabel }}</span>
    </div>
    <div class="card-details">
        <p>{{ server.details }}</p>
        <p>
            {% if server.tag %}<span class="tag">{{ server.tag }}</span>{% endif %}
            {% if server.group %}<span class="tag tag-group">{{ server.group }}</span>{% endif %}
            {% if server.release %}<span class="tag">Release: {{ server.release }}</span>{% endif %}
            {% if server.popTier and server.popTier != "unknown" %}<span class="tag">Pop: {{ server.popTier | capitalize }}</span>{% endif %}
            {% if server.shutdown %}<span class="tag tag-dead">Down {{ server.shutdown }}{% if server.shutdownReason %} · {{ server.shutdownReason }}{% endif %}</span>{% endif %}
            {% if server.updated %}<span class="tag">Last checked: {{ server.updated | formatDate }}</span>{% endif %}
            {% if server.url %}<a class="tag tag-link" href="{{ server.url }}" target="_blank" rel="noopener noreferrer">Visit ↗</a>{% endif %}
            {% if server.name == "Octo WoW" %}<a class="tag tag-link" href="/guides/octowow/">Setup Guide →</a>{% endif %}
        </p>
    </div>
</article>

{% if related | length %}
<section class="timeline related-history">
    <h2>Related history</h2>
    {% for h in related %}
    <div class="timeline-item">
        <div class="timeline-marker" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/></svg></div>
        <div class="timeline-body">
            <div class="timeline-date">{{ h.date }}</div>
            <h3>{{ h.title }}</h3>
            {% if h.tag %}<span class="tag">{{ h.tag }}</span>{% endif %}
            {% for p in h.paragraphs %}<p>{{ p }}</p>{% endfor %}
        </div>
    </div>
    {% endfor %}
</section>
{% endif %}
