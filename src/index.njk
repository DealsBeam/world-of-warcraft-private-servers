---
layout: null
permalink: /
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>World of Warcraft Private Server Status List</title>
    <meta name="description" content="Comprehensive tracker of World of Warcraft private servers, emulation history, news, and modding resources.">
    <link rel="canonical" href="https://wowprivateservers.vercel.app/">
    <link rel="alternate" type="application/rss+xml" title="World of Warcraft Private Server News" href="https://wowprivateservers.vercel.app/feed.xml">
    <meta property="og:type" content="website">
    <meta property="og:title" content="World of Warcraft Private Server Status List">
    <meta property="og:description" content="Comprehensive tracker of World of Warcraft private servers, emulation history, news, and modding resources.">
    <meta property="og:url" content="https://wowprivateservers.vercel.app/">
    <meta property="og:image" content="https://wowprivateservers.vercel.app/og.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="World of Warcraft Private Server Status List">
    <meta name="twitter:description" content="Comprehensive tracker of World of Warcraft private servers, emulation history, news, and modding resources.">
    <meta name="twitter:image" content="https://wowprivateservers.vercel.app/og.png">
    <script>
        (function () {
            try {
                var t = localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
                document.documentElement.setAttribute("data-theme", t);
            } catch (e) {}
        })();
    </script>
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="header-banner">
        <svg class="hero-art" viewBox="0 0 1040 240" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
            <path class="ha-mount-back" d="M0 210 L180 70 L330 200 L480 90 L640 210 L820 110 L1040 220 L1040 240 L0 240 Z"/>
            <path class="ha-mount" d="M0 240 L220 120 L380 230 L560 130 L760 240 L900 170 L1040 235 L1040 240 L0 240 Z"/>
            <path class="ha-keep" d="M470 240 L470 170 L500 170 L500 150 L540 150 L540 170 L570 170 L570 240 Z M505 150 L505 120 L510 118 L510 150 Z M530 150 L530 118 L535 120 L535 150 Z"/>
            <circle class="ha-glow" cx="870" cy="70" r="46"/>
            <circle class="ha-glow" cx="870" cy="70" r="70"/>
        </svg>
        <h1>World of Warcraft Private Servers</h1>
        <p class="subtitle">Comprehensive Status Tracker, Emulation History &amp; Development Directory</p>
        <div class="meta-info">
            Compiled from community updates · last reviewed {{ site.reviewed }}
        </div>
        <div class="theme-toggle" role="group" aria-label="Theme">
            <button type="button" data-theme-choice="light" aria-pressed="false" title="Light theme">☀</button>
            <button type="button" data-theme-choice="system" aria-pressed="false" title="System theme">⚙</button>
            <button type="button" data-theme-choice="dark" aria-pressed="false" title="Dark theme">☾</button>
        </div>
        <nav class="site-nav">
            <a href="/">Home</a>
            <a href="/news/">News</a>
            <a href="/classic-plus/">Classic+ Tracker</a>
            <a href="/guides/octowow/">OctoWoW Guide</a>
            <a href="/radio/">Radio</a>
        </nav>
    </header>

    {% set statusLabel = { "playable": ["Playable", "badge-green"], "dev": ["In-Development", "badge-yellow"], "closed": ["Shut Down", "badge-red"] } %}
    {% set eraMap = { "Vanilla": "Vanilla", "TBC": "TBC", "WotLK": "WotLK", "Cataclysm": "Cataclysm", "MoP": "MoP", "Legion": "Legion", "TWW": "TWW", "Vanilla+": "Vanilla", "Classless": "Vanilla", "Multi": "Multi", "MOBA": "Other", "": "Other" } %}
    {% set eraOrder = ["Vanilla", "TBC", "WotLK", "Cataclysm", "MoP", "Legion", "TWW", "Multi", "Other"] %}
    {% set iconPath = { "server": "M3 3h18v4H3zM3 10h18v4H3zM3 17h18v4H3zM7 5h.01M7 12h.01M7 19h.01", "globe": "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z", "wrench": "M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z", "leaf": "M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10zM2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" } %}
    {% set htype = { "core": ["Core Emulators", "server"], "web": ["Web & Analytics", "globe"], "tools": ["Development Tools", "wrench"] } %}

    <nav class="tabs" role="tablist" aria-label="Site sections">
        <button class="tab active" data-tab="servers" role="tab" aria-selected="true">Servers</button>
        <button class="tab" data-tab="history" role="tab" aria-selected="false">History</button>
        <button class="tab" data-tab="links" role="tab" aria-selected="false">News &amp; Links</button>
    </nav>

    <main id="main-content">

        <section id="view-servers" class="view active" role="tabpanel">
            <div class="stat-strip" id="stat-strip" aria-label="Server status counts">
                <div class="stat"><span class="stat-num">{{ servers.length }}</span><span class="stat-label">Tracked servers</span></div>
                <div class="stat stat-green"><span class="stat-num">{{ servers | countByStatus("playable") }}</span><span class="stat-label">Playable</span></div>
                <div class="stat stat-yellow"><span class="stat-num">{{ servers | countByStatus("dev") }}</span><span class="stat-label">In development</span></div>
                <div class="stat stat-red"><span class="stat-num">{{ servers | countByStatus("closed") }}</span><span class="stat-label">Shut down</span></div>
            </div>

            {% set recent = servers | selectattr("updated") | sort(attribute="updated", reverse=true) | list %}
            {% if recent | length %}
            <section class="panel recent-panel">
                <h2>Recently updated</h2>
                <ul class="recent-list">
                    {% for s in recent | take(6) %}
                    <li><span class="news-chip" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg></span><a href="/servers/{{ s.name | slugify }}/">{{ s.name }}</a> <span class="tag">{{ s.updated | formatDate }}</span></li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            <div class="controls">
                <div class="chips" id="chips" role="group" aria-label="Filter by status">
                    <button class="chip active" data-status="all" aria-pressed="true">All</button>
                    <button class="chip" data-status="playable" aria-pressed="false">🟢 Playable</button>
                    <button class="chip" data-status="dev" aria-pressed="false">🟡 In Dev</button>
                    <button class="chip" data-status="closed" aria-pressed="false">🔴 Shut Down</button>
                </div>

                <div class="filters">
                    <label class="sr-only" for="search">Search servers</label>
                    <input type="search" id="search" placeholder="Search servers…" autocomplete="off">
                    <label class="sr-only" for="tag">Filter by type</label>
                    <select id="tag">
                        <option value="all">All types</option>
                        {% for t in servers | uniqueTags %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
                    </select>
                </div>
            </div>

            <p class="count" id="count">{{ servers.length }} of {{ servers.length }} servers</p>
            <p class="empty" id="empty" hidden>No servers match your filters.</p>
            <div class="cards" id="cards">
                {% for g in servers | groupByEra %}
                <h2 class="era-title"><a href="/{{ g.era | lower | slugify }}/">{{ g.era }}</a><span class="era-count">{{ g.servers.length }}</span></h2>
                {% for s in g.servers %}
                {% set lbl = statusLabel[s.status] or ["Unknown", ""] %}
                <article class="card">
                    <div class="card-head">
                        <span class="server-name"><a class="server-link" href="/servers/{{ s.name | slugify }}/">{{ s.name }}</a>{% if s.group and s.name.indexOf(s.group) === -1 %} <span class="tag tag-group">{{ s.group }}</span>{% endif %}</span>
                        <span class="badge {{ lbl[1] }}">{{ lbl[0] }}</span>
                    </div>
                    <div class="card-details">{{ s.details }}{% if s.tag %} <span class="tag">{{ s.tag }}</span>{% endif %}{% if s.release %} <span class="tag">Release: {{ s.release }}</span>{% endif %}</div>
                    {% if s.url %}<a class="card-site" href="{{ s.url }}" target="_blank" rel="noopener">Official site ↗</a>{% endif %}
                </article>
                {% endfor %}
                {% endfor %}
            </div>
        </section>

        <section id="view-history" class="view" role="tabpanel" hidden>
            <div class="history-toolbar">
                <label class="sr-only" for="history-search">Search history</label>
                <input type="search" id="history-search" placeholder="Search history events…" autocomplete="off">
                <div class="filter-row" id="history-filters">
                    <button class="chip active" data-hcat="all" aria-pressed="true">All</button>
                    {% for c in history | uniqueCategories %}{% set ht = htype[c] or ["", "leaf"] %}<button class="chip" data-hcat="{{ c }}" aria-pressed="false">{{ ht[0] }}</button>{% endfor %}
                </div>
            </div>
            <p class="empty" id="history-empty" hidden>No history events match your filters.</p>
            <div class="timeline" id="timeline">
                {% for h in history %}
                {% set ht = htype[h.category] or ["", "leaf"] %}
                <div class="timeline-item" data-cat="{{ h.category }}">
                    <div class="timeline-marker" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="{{ iconPath[ht[1]] }}"/></svg></div>
                    <div class="timeline-body">
                        <div class="timeline-date">{{ h.date }}</div>
                        <h3>{{ h.title }}</h3>
                        {% if h.tag %} <span class="tag">{{ h.tag }}</span>{% endif %}
                        {% for p in h.paragraphs %}<p>{{ p }}</p>{% endfor %}
                        {% if h.githubRepo %}<div class="timeline-repo"><a href="https://github.com/{{ h.githubRepo }}" target="_blank" rel="noopener">{{ h.githubRepo }}</a></div>{% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>

        <section id="view-links" class="view" role="tabpanel" hidden>
            <section class="panel">
                <h2>News</h2>
                <ul id="news-list">
                    {% for n in collections.news | reverse %}<li><span class="news-chip" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg></span><a href="{{ n.data.link or n.url }}"{% if n.data.link %} target="_blank" rel="noopener"{% endif %}>{{ n.data.title }}</a></li>{% endfor %}
                </ul>
            </section>
            <section class="panel">
                <h2>Mods &amp; Creations</h2>
                <ul id="link-list">
                    {% for l in links %}<li><a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.title }}</a></li>{% endfor %}
                </ul>
            </section>
        </section>

        <section class="panel about-panel">
            <h2>How this list works</h2>
            <p>Every server, status and date here is curated and formatted from Discord community updates and public announcements — nothing is automated guesswork. Playable status means the server is open to players; In-Development means a public release is still ahead. Statuses are subject to change and were last reviewed {{ site.reviewed }}. We are not affiliated with Blizzard Entertainment, and WoW private servers exist outside of it.</p>
        </section>

    </main>

    <div class="footer">
        <div class="radio-strip">
            <audio id="radio-audio" preload="none" src="https://radio.outofbounds.live/listen/out_of_bounds/radio.mp3"></audio>
            <span class="radio-title"><a href="/radio/">Out of Bounds Radio</a><span class="radio-sub"> — formerly Everlook Broadcasting Co.</span></span>
            <button type="button" class="chip radio-btn" id="radio-btn" aria-pressed="false">▶ Play</button>
            <span class="radio-now" id="radio-now">Checking stream…</span>
            <span class="radio-links"><a href="https://www.outofbounds.live/" target="_blank" rel="noopener">outofbounds.live ↗</a> · <a href="https://tinyurl.com/outofboundsdiscord" target="_blank" rel="noopener">Discord</a></span>
        </div>
        List curated and formatted from Discord community updates. Statuses subject to change.
    </div>

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "World of Warcraft Private Servers",
        "itemListElement": [
        {% for s in servers %}
        { "@type": "ListItem", "position": {{ loop.index }}, "name": "{{ s.name }}", "url": "https://wowprivateservers.vercel.app/servers/{{ s.name | slugify }}/" }{{ "," if not loop.last }}
        {% endfor %}
        ]
    }
    </script>
    <script src="data.js"></script>
    <script src="theme.js"></script>
    <script src="radio.js"></script>
    <script src="app.js"></script>
</body>
</html>