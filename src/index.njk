---
layout: base.njk
permalink: /
title: World of Warcraft Private Server Status List
description: Comprehensive tracker of World of Warcraft private servers, emulation history, news, and modding resources.
canonical: https://wowprivateservers.vercel.app/
hero: World of Warcraft Private Servers
subtitle: Comprehensive Status Tracker, Emulation History & Development Directory
heroImage: /images/hero-1.jpeg
eleventyComputed:
    metaInfo: "Compiled from community updates · last reviewed {{ site.reviewed }}"
extraScripts:
    - /data.js
    - /app.js
---
{% from "card.njk" import card with context %}
{% from "medallion.njk" import eraMedallion %}
    {% set iconPath = vocab.ICONS %}
    {% set htype = { "core": [vocab.HTYPE.core.label, vocab.HTYPE.core.icon], "web": [vocab.HTYPE.web.label, vocab.HTYPE.web.icon], "tools": [vocab.HTYPE.tools.label, vocab.HTYPE.tools.icon] } %}

    <nav class="tabs" role="tablist" aria-label="Site sections">
        <button class="tab active" data-tab="servers" role="tab" aria-selected="true">Servers</button>
        <button class="tab" data-tab="history" role="tab" aria-selected="false">History</button>
        <button class="tab" data-tab="links" role="tab" aria-selected="false">News &amp; Links</button>
    </nav>

    <section id="view-servers" class="view active" role="tabpanel">
        <div class="stat-strip" id="stat-strip" aria-label="Server status counts">
            <div class="stat"><span class="stat-num">{{ servers.length }}</span><span class="stat-label">Tracked servers</span></div>
            <div class="stat stat-green"><span class="stat-num">{{ servers | countByStatus("playable") }}</span><span class="stat-label">Playable</span></div>
            <div class="stat stat-yellow"><span class="stat-num">{{ servers | countByStatus("dev") }}</span><span class="stat-label">In development</span></div>
            <div class="stat stat-red"><span class="stat-num">{{ servers | countByStatus("dead") }}</span><span class="stat-label">Dead</span></div>
        </div>

        <section class="panel" style="border:1px solid var(--border);background:linear-gradient(180deg, rgba(196,154,40,0.08), transparent 60%)">
            <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center">
                <img src="{{ featured.image }}" alt="" width="96" height="64" style="object-fit:cover;border-radius:8px;flex:0 0 auto">
                <div>
                    <h2 style="margin:0;font-size:1.05rem">⭐ {{ featured.heading }}</h2>
                    <p class="meta-info" style="margin:4px 0 8px">{{ featured.blurb }} He reviewed our tracker {{ featured.review.date | daysAgo }} days ago.</p>
                    <p style="margin:0;display:flex;gap:8px;flex-wrap:wrap">
                        {% for l in featured.links %}<a class="chip{% if loop.first %} active{% endif %}" href="{{ l.url }}"{% if l.external %} target="_blank" rel="noopener"{% endif %}>{{ l.label }}</a>{% endfor %}
                    </p>
                </div>
            </div>
        </section>

        {% set recent = servers | selectattr("updated") | sort(attribute="updated", reverse=true) | list %}
        {% if recent | length %}
        <section class="panel recent-panel">
            <h2>Recently updated</h2>
            <ul class="recent-list">
                {% for s in recent | take(6) %}
                <li><span class="news-chip" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg></span><a href="/servers/{{ s.name | slugify }}/">{{ s.name }}</a> <span class="tag">{{ s.updated | formatDate }}</span></li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}

        <div class="controls">
            <div class="chips" id="chips" role="group" aria-label="Filter by status">
                <button class="chip active" data-status="all" aria-pressed="true">All</button>
                <button class="chip" data-status="playable" aria-pressed="false">🟢 Playable</button>
                <button class="chip" data-status="dev" aria-pressed="false">🟡 In Dev</button>
                <button class="chip" data-status="dead" aria-pressed="false">💀 Dead</button>
            </div>

            <div class="filters">
                <label class="sr-only" for="search">Search servers</label>
                <input type="search" id="search" placeholder="Search servers…" autocomplete="off">
                <label class="sr-only" for="tag">Filter by type</label>
                <select id="tag">
                    <option value="all">All types</option>
                    {% for t in servers | uniqueTags %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
                </select>
                <label class="sr-only" for="pop">Filter by population</label>
                <select id="pop">
                    <option value="all">All populations</option>
                    <option value="large">Large</option>
                    <option value="medium">Medium</option>
                    <option value="small">Small</option>
                    <option value="tiny">Tiny</option>
                    <option value="unknown">Unknown</option>
                </select>
            </div>
        </div>

        <p class="count" id="count" aria-live="polite" aria-atomic="true">{{ servers.length }} of {{ servers.length }} servers</p>
        <p class="empty" id="empty" hidden role="status">No servers match your filters.</p>
        <div class="cards" id="cards">
            {% for g in servers | groupByEra %}
            <h2 class="era-title">{{ eraMedallion(g.era) }}<a href="/{{ g.era | lower | slugify }}/">{{ g.era }}</a><span class="era-count">{{ g.servers.length }}</span></h2>
            {% for s in g.servers %}
            {{ card(s) }}
            {% endfor %}
            {% endfor %}
        </div>
    </section>

    <section id="view-history" class="view" role="tabpanel" hidden>
        <div class="history-toolbar">
            <label class="sr-only" for="history-search">Search history</label>
            <input type="search" id="history-search" placeholder="Search history events…" autocomplete="off">
            <div class="filter-row" id="history-filters">
                <button class="chip active" data-hcat="all" aria-pressed="true">All</button>
                {% for c in history | uniqueCategories %}{% set ht = htype[c] or ["", "leaf"] %}<button class="chip" data-hcat="{{ c }}" aria-pressed="false">{{ ht[0] }}</button>{% endfor %}
            </div>
        </div>
        <p class="empty" id="history-empty" hidden role="status">No history events match your filters.</p>
        <div class="timeline" id="timeline">
            {% for h in history %}
            {% set ht = htype[h.category] or ["", "leaf"] %}
            <div class="timeline-item" data-cat="{{ h.category }}" id="{{ h.id }}">
                <div class="timeline-marker" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="{{ iconPath[ht[1]] }}"/></svg></div>
                <div class="timeline-body">
                    <div class="timeline-date">{{ h.date }}</div>
                    <h3>{{ h.title }}</h3>
                    {% if h.tag %} <span class="tag">{{ h.tag }}</span>{% endif %}
                    {% for p in h.paragraphs %}<p>{{ p }}</p>{% endfor %}
                    {% if h.githubRepo %}<div class="timeline-repo"><a href="https://github.com/{{ h.githubRepo }}" target="_blank" rel="noopener">{{ h.githubRepo }}</a></div>{% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </section>

    <section id="view-links" class="view" role="tabpanel" hidden>
        <section class="panel">
            <h2>News</h2>
            <ul id="news-list">
                {% for n in collections.news | reverse %}{% if not n.data.archived %}<li><span class="news-chip" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg></span><a href="{{ n.url }}">{{ n.data.title }}</a></li>{% endif %}{% endfor %}
            </ul>
        </section>
        <section class="panel">
            <h2>From the blog</h2>
            <ul class="news-list">
                {% for p in collections.blog | reverse | take(3) %}<li><a href="{{ p.url }}">{{ p.data.title }}</a></li>{% endfor %}
            </ul>
            <p><a href="/blog/">All posts →</a></p>
        </section>
        <section class="panel">
            <h2>Mods &amp; Creations</h2>
            <ul id="link-list">
                {% for l in links %}<li><a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.title }}</a></li>{% endfor %}
            </ul>
        </section>
    </section>

    <section class="panel about-panel">
        <h2>How this list works</h2>
        <p>Every server, status and date here is curated and formatted from Discord community updates and public announcements — nothing is automated guesswork. Playable status means the server is open to players; In-Development means a public release is still ahead. Statuses are subject to change and were last reviewed {{ site.reviewed }}. Listed servers are unlicensed third-party projects; we are not affiliated with Blizzard Entertainment, and linking does not imply endorsement.</p>
        <p class="meta-info">Heard the signal survive? <a href="/radio/">Out of Bounds Radio</a> — the survivor station from Turtle WoW's in-game Everlook Broadcasting Co., now streaming 24/7.</p>
    </section>

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "World of Warcraft Private Servers",
        "itemListElement": [
        {% for s in servers %}
        { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ s.name | dump | safe }}, "url": "https://wowprivateservers.vercel.app/servers/{{ s.name | slugify }}/" }{{ "," if not loop.last }}
        {% endfor %}
        ]
    }
    </script>