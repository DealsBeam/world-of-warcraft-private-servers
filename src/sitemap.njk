---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url><loc>https://wowprivateservers.vercel.app/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/news/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/blog/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/classic-plus/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/guides/octowow/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/census/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/radio/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/music/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/creators/malonze-gaming/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/shop/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/disclaimer/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/contact/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    {% for g in vocab.GAMES %}
    <url><loc>https://wowprivateservers.vercel.app/category/{{ g }}/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
{% endfor %}
    <url><loc>https://wowprivateservers.vercel.app/privacy/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    <url><loc>https://wowprivateservers.vercel.app/terms/</loc><lastmod>{{ site.reviewedIso }}</lastmod></url>
    {% for e in vocab.ERA_ORDER %}
    <url><loc>https://wowprivateservers.vercel.app/{{ e | lower }}/</loc></url>
{% endfor %}
{% for s in servers %}
    {% if s.status !== "dead" %}
    <url><loc>https://wowprivateservers.vercel.app/servers/{{ s.name | slugify }}/</loc>{% if s.updated %}<lastmod>{{ s.updated }}</lastmod>{% endif %}</url>
    {% endif %}
{% endfor %}
{% for n in collections.news %}
    <url><loc>https://wowprivateservers.vercel.app{{ n.url }}</loc><lastmod>{{ n.date | isoDate }}</lastmod></url>
{% endfor %}
{% for p in collections.blog %}
    <url><loc>https://wowprivateservers.vercel.app{{ p.url }}</loc><lastmod>{{ p.date | isoDate }}</lastmod></url>
{% endfor %}
</urlset>
