{
  "name": "world-of-warcraft-private-servers",
  "version": "1.0.0",
  "private": true,
  "description": "World of Warcraft private server status tracker",
  "scripts": {
    "build": "eleventy && node scripts/smoke.js",
    "serve": "eleventy --serve",
    "test": "node test/server-data.test.js",
    "lighthouse": "npx lighthouse http://localhost:8082 --output=json --output-path=./lighthouse-report.json --chrome-flags=\"--headless --no-sandbox\" 2>&1 | tail -5"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
