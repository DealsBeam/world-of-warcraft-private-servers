{
  "name": "world-of-warcraft-private-servers",
  "version": "1.0.0",
  "private": true,
  "description": "World of Warcraft private server status tracker",
  "scripts": {
    "build": "rm -rf _site && eleventy && node scripts/smoke.js",
    "serve": "eleventy --serve",
    "test": "node test/server-data.test.js",
    "lighthouse": "node scripts/lighthouse.js",
    "check:deploy": "node scripts/check-deploy.js",
    "check:deps": "node scripts/check-deps.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
